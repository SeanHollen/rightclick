{
  "manifest_version": 3,
  "name": "Right Click New Tab",
  "version": "1.1.0",
  "description": "Right-clicking a link opens it in a new tab, placed exactly where a middle-click would put it.",
  "minimum_chrome_version": "102",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "options_ui": {
    "page": "options.html"
  }
}
