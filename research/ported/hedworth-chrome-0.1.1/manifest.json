{
 "manifest_version": 2,
 "name": "Right Click Opens Link New Tab",
 "version": "0.1.1",
 "description": "Right Click Opens Link in New Tab in the Correct Order",
 "icons": {
  "16": "icons/16.png",
  "32": "icons/32.png",
  "48": "icons/48.png",
  "128": "icons/128.png"
 },
 "author": "Bill Hedworth",
 "background": {
  "scripts": [
   "js/webext.js",
   "js/background.js"
  ]
 },
 "content_scripts": [
  {
   "matches": [
    "http://*/*",
    "https://*/*"
   ],
   "js": [
    "js/webext.js",
    "js/content_script.js"
   ],
   "all_frames": true
  }
 ],
 "permissions": [
  "storage"
 ],
 "options_ui": {
  "page": "config/settings.html",
  "open_in_tab": true
 },
 "short_name": "Tab Opener",
 "browser_action": {
  "default_popup": "config/settings.html",
  "default_icon": {
   "16": "icons/16.png",
   "32": "icons/32.png",
   "48": "icons/48.png",
   "128": "icons/128.png"
  }
 },
 "browser_specific_settings": {
  "gecko": {
   "id": "hedworth-chrome-0.1.1@test"
  }
 }
}